  npcName: "Arch\xE9ologue"
  npcPortrait: {fileID: 21300000, guid: 41abe5e685221aa4db2e127f6837a817, type: 3}
  playerPortrait: {fileID: 21300000, guid: aac3ceb7a1214734aaa33b9d5bd4941c, type: 3}
  isBadDecision: 0
  lines:
  - speaker: 0
    text: "Quelqu'un a jet\xE9 ceci dans la poubelle plus loin, pour une raison que
      j'ignore."
  - speaker: 1
    text: Comment oser jeter une telle merveille ?!
  - speaker: 0
    text: "Je dois dire que je vois pas trop l'int\xE9r\xEAt, pour \xEAtre honn\xEAte."
  - speaker: 1
    text: "C'est le vestige d'une des plus grandes armes du monde ancien ! Un d\xE9mon
      de m\xE9tal que portaient chaques soldats, crachant des flammes et de l'acier
      sur leurs ennemis !"
  - speaker: 0
    text: "Mais , c'est terrifiant ! Qui souhaiterait avoir un d\xE9mon pr\xE8s de
      sois ?! Prends le , je ne veux pas l'avoir une seconde de plus !"
  - speaker: 1
    text: "Vous \xEAtes tous trop ferm\xE9 au pass\xE9 et \xE0 notre histoire. Enfin...
      fut une \xE9poque je n'\xE9tais pas le seul que \xE7a int\xE9ressait.."
  triggersCardGame: 0
  enemyCardData: {fileID: 0}
  playerCardData: {fileID: 0}
  ItemGameReward: {fileID: 0}
