  m_Script: {fileID: 11500000, guid: b13b48e65550d1a4f80dbc0550ba6b7b, type: 3}
  m_Name: PageJournal
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: "Arch\xE9ologue"
  npcPortrait: {fileID: 21300000, guid: 41abe5e685221aa4db2e127f6837a817, type: 3}
  playerPortrait: {fileID: 21300000, guid: aac3ceb7a1214734aaa33b9d5bd4941c, type: 3}
  isBadDecision: 0
  lines:
  - speaker: 1
    text: "Je t'en prie , je ne veux pas en lire plus. Cela fait d\xE9\xE0 si longtemps
      qu'elles sont parti et je ne veux plus me rappeler de mon plus grand \xE9chec."
  - speaker: 0
    text: "Quel \xE9chec ?"
  - speaker: 1
    text: "Parfois voyageur ... Il est plus sage de garder ses passions pour sois.
      Quand quelqu'un de proche fini par s'y int\xE9resser, cela peut leurs faire
      du mal."
  - speaker: 0
    text: "Et cette personne l\xE0 , qu'est elle devenu ? "
  - speaker: 1
    text: "Je pr\xE9f\xE8re ne pas en parl\xE9 ... C'est une partie de mon pass\xE9
      que je pr\xE9f\xE9rerai oubli\xE9. "
  - speaker: 1
    text: "J'esp\xE8re seulement qu'elles me pardonneront un jour."
  triggersCardGame: 0
