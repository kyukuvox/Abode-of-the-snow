  m_Script: {fileID: 11500000, guid: b13b48e65550d1a4f80dbc0550ba6b7b, type: 3}
  m_Name: Dagger
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Guard
  npcPortrait: {fileID: 21300000, guid: a12205541509adf4eba26d9cead915af, type: 3}
  playerPortrait: {fileID: 21300000, guid: aac3ceb7a1214734aaa33b9d5bd4941c, type: 3}
  isBadDecision: 1
  lines:
  - speaker: 1
    text: "Do you dare to come face to face with a blade, hoping I\u2019ll let you
      go without consequences?!"
  - speaker: 0
    text: "But I wasn\u2019t counting..."
  - speaker: 1
    text: 'Do you think our saviour would forgive you for threatening one of his
      sons? '
  - speaker: 0
    text: The lord will know how to forgive an ignorant!
  - speaker: 1
    text: A fool, perhaps, but a madman cannot find himself with him in his kingdom
      beyond the clouds.
  - speaker: 1
    text: If your mentality is so irreligious, abandon your pilgrimage and go home
      traveler.
