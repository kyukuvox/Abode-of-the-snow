  m_Script: {fileID: 11500000, guid: b13b48e65550d1a4f80dbc0550ba6b7b, type: 3}
  m_Name: AlreadyDefeated
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Atheist
  npcPortrait: {fileID: 21300000, guid: f6d820a7266204e4b8d98d50913746c6, type: 3}
  playerPortrait: {fileID: 21300000, guid: aac3ceb7a1214734aaa33b9d5bd4941c, type: 3}
  isBadDecision: 0
  lines:
  - speaker: 1
    text: "It\u2019s okay, I really remember everything. How could I have even forgotten
      the thought that pushed me to climb the mountain?"
  - speaker: 1
    text: Pilgrim, you who climbed the mountain and will reach the top. I would like
      you to carry this letter with you.
  - speaker: 0
    text: Of course, but what does it contain?
  - speaker: 1
    text: Everything I would have liked to be able to say to my daughter. The words
      of a mother who would have liked to hold her child in her arms one last time.
  - speaker: 1
    text: "In short, that\u2019s all the love I have for her. "
  - speaker: 1
    text: "It\u2019s finally time for me to go home."
  triggersCardGame: 0
