  m_Name: GodEye
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Priest
  npcPortrait: {fileID: 21300000, guid: 1ad02a1cb9d09e14581bf86b6b08ede7, type: 3}
